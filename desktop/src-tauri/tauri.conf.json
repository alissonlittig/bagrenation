{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BAGRENATION",
  "version": "1.0.1",
  "identifier": "io.github.alissonlittig.bagrenation",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node copy-site.mjs",
    "beforeDevCommand": "node copy-site.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BAGRENATION",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0614",
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Alisson Littig",
    "copyright": "MIT",
    "shortDescription": "Voz e tela com os amigos por um ID de sala",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QzAyQTI3NkQwRTY1ODEKUldTQlpRNXRKeXJBRjdHRlZxT3l6d2sxcVY5MW56WkNudDJibGJPQVNPUmFHUTR3TDd1NzhMQncK",
      "endpoints": ["https://github.com/alissonlittig/bagrenation/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
